# MySQL 8 — create database csumroh first or run prisma db push.
DATABASE_URL="mysql://root:password@127.0.0.1:3306/csumroh"

# Generate strong random values; never reuse secrets from the legacy repository.
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"
WA_GATEWAY_SECRET="replace-with-a-random-internal-service-secret"

API_PORT=4000
WA_GATEWAY_PORT=4001
WA_GATEWAY_URL="http://localhost:4001"
WEB_ORIGIN="http://localhost:5173"
API_INTERNAL_URL="http://localhost:4000"
VITE_API_URL="http://localhost:4000/api/v1"
VITE_SOCKET_URL="http://localhost:4000"
META_GRAPH_API_VERSION="v20.0"

# Bootstrap creates only one superadmin. Brand, package, team, prospect, chat,
# and WhatsApp data must come from real operator input or connected services.
SEED_SUPERADMIN_EMAIL="owner@example.com"
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_PASSWORD="change-me-before-seeding"

# MySQL 8 — create database csumroh first or run prisma db push.
DATABASE_URL="mysql://root:password@127.0.0.1:3306/csumroh"

# Generate strong random values; never reuse secrets from the legacy repository.
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"
WA_GATEWAY_SECRET="replace-with-a-random-internal-service-secret"

API_PORT=4000
WA_GATEWAY_PORT=4001
# Gateway hanya didengar di mesin yang sama dengan API; ubah bila API berjalan di host lain.
WA_GATEWAY_HOST=127.0.0.1
WA_GATEWAY_URL="http://localhost:4001"
WEB_ORIGIN="http://localhost:5173"
API_INTERNAL_URL="http://localhost:4000"
VITE_API_URL="http://localhost:4000/api/v1"
VITE_SOCKET_URL="http://localhost:4000"
META_GRAPH_API_VERSION="v20.0"
# Minimum 32 characters. Used to encrypt per-brand Meta access tokens at rest.
META_TOKEN_ENCRYPTION_KEY="replace-with-a-different-32-character-encryption-key"
# Optional: Meta App for the "Hubungkan Meta" button (OAuth, ads_read). Leave empty to paste tokens manually.
# META_OAUTH_REDIRECT_URI must match "Valid OAuth Redirect URIs" in the Meta App exactly.
# META_APP_ID="1234567890"
# META_APP_SECRET="app-secret-from-meta-app-settings"
# META_OAUTH_REDIRECT_URI="http://localhost:4000/api/v1/meta/oauth/callback"
# Only for Meta Apps using "Facebook Login for Business": Configuration ID (permissions live in the Configuration).
# META_OAUTH_CONFIG_ID="1234567890"

# Bootstrap creates only one superadmin. Brand, package, team, prospect, chat,
# and WhatsApp data must come from real operator input or connected services.
SEED_SUPERADMIN_EMAIL="owner@example.com"
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_PASSWORD="change-me-before-seeding"
# Akun uji per role (hanya DB lokal): pnpm --filter @csumroh/api db:seed:roles
SEED_ROLE_PASSWORD="change-me-local-test-password"

# Notifikasi in-app dan job berkala (SLA balasan, ringkasan harian, retensi). Nilai: true/false.
NOTIFICATIONS_ENABLED="true"
SCHEDULER_ENABLED="true"

# Batas waktu panggilan Asisten AI (ms). Kunci API, model, dan peserta diatur Superadmin di menu Pengaturan > Asisten AI.
AI_TIMEOUT_MS="20000"
